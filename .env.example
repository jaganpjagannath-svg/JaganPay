# ===================================================
# JAGANPAY ENVIRONMENT CONFIGURATION
# ===================================================
# IMPORTANT: JaganPay is a payment simulation and does NOT process real money.

SECRET_KEY=jaganpay-secure-demo-secret-key-change-in-production-2026
DATABASE_URL=sqlite:///jaganpay.db
FLASK_ENV=development
DEBUG=True
PORT=5000

# OTP Delivery Provider Settings
# Options: "mock" (prints ONLY to backend server terminal for local development)
#          "production" (uses real SMS API / real SMTP, zero console OTP prints)
OTP_PROVIDER_MODE=mock

# SMS Provider Configuration (for production)
SMS_PROVIDER=mock
SMS_API_KEY=

# Email Provider Configuration (SMTP)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_FROM_EMAIL="JaganPay Verification <noreply@jaganpay.local>"

# OTP Security Parameters
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Google Gemini API Key (Official google-genai SDK)
GEMINI_API_KEY=

# Simulation Mode
DEMO_MODE=True
SENSITIVE_TRANSACTION_THRESHOLD=10000.0

# n8n Webhook Integration
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_REGISTRATION=http://localhost:5678/webhook/jaganpay-registration
N8N_WEBHOOK_OTP=http://localhost:5678/webhook/jaganpay-otp
N8N_WEBHOOK_PAYMENT_SUCCESS=http://localhost:5678/webhook/jaganpay-payment-success
N8N_WEBHOOK_PAYMENT_FAILURE=http://localhost:5678/webhook/jaganpay-payment-failure
N8N_WEBHOOK_RISK_ALERT=http://localhost:5678/webhook/jaganpay-risk-alert
N8N_WEBHOOK_DAILY_SUMMARY=http://localhost:5678/webhook/jaganpay-daily-summary
N8N_WEBHOOK_SUPPORT=http://localhost:5678/webhook/jaganpay-support
N8N_WEBHOOK_ADMIN_REPORT=http://localhost:5678/webhook/jaganpay-admin-report
